# 网关配置样例。复制为 .env（本地）或 .env.prod（生产）后按需覆盖。
#
# 变量名沿用 DJANGO_* 前缀是历史遗留：Django 已退役，但部署脚本与密钥管理
# 都按这套名字配好了，为了改名去动运维不划算。

# ── 网关 ───────────────────────────────────────────────
GO_LISTEN_ADDR=:8000
DJANGO_SECRET_KEY=dev-only-change-me-in-production
DJANGO_DEBUG=true
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 对外可访问的基址，用于拼 avatar_url / 合同 pdf_url 等绝对地址
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 用户上传物落盘根目录（容器里挂卷到 /app/media）
MEDIA_ROOT=/app/media

# ── PostgreSQL ─────────────────────────────────────────
POSTGRES_DB=tms
POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_dev_pwd
DATABASE_URL=postgres://tms:tms_dev_pwd@db:5432/tms

# ── JWT ────────────────────────────────────────────────
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7

# ── DeepSeek (AI) ──────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ── Agent ──────────────────────────────────────────────
AGENT_MAX_TOOL_LOOPS=8
# 外部 MCP server（JSON，空对象则不加载）。形如：
#   {"docs":{"url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer …"}}}
# 会改数据的 server 请加 "risk":"high"，其工具便不进 AI 自动循环、只登记待人工确认。
AGENT_MCP_SERVERS={}

# ── 车联网 / 报警 ──────────────────────────────────────
ALERT_SPEED_LIMIT_KMH=90
DEVICE_OFFLINE_MINUTES=10
# 高德地图 Key 是**构建期**变量（Vite 在 npm run build 时编进产物），
# 名字必须带 VITE_ 前缀，且要在构建前端镜像时就设好，容器起来再设没用。
VITE_AMAP_KEY=
# MQTT 终端接入；MQTT_HOST 留空则不启用
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=tms/telemetry/#
MQTT_USERNAME=
MQTT_PASSWORD=
