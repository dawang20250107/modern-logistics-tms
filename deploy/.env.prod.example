# 生产环境变量模板。
#
#   cp deploy/.env.prod.example deploy/.env.prod   # 然后逐项改
#
# .env.prod 本身**不要进版本库**（.gitignore 已经挡了）。
#
# 带 ⚠️ 的几项没有默认值：漏配的话 compose 会直接报错拒绝启动，
# 好过带着占位值跑起来——网关的启动前置检查也会在 DJANGO_DEBUG=false 时
# 拦住弱密钥与 CORS 通配符。

# ── ⚠️ 必改 ────────────────────────────────────────────────

# 强随机 ≥32 字节。生成：openssl rand -base64 48
# 这把钥匙同时签发内部用户令牌与司机端令牌。用公开已知的默认值
# 等于任何人都能自签一张管理员令牌进来。
DJANGO_SECRET_KEY=

# 数据库口令（用托管 PG 时改下面的 DATABASE_URL，这条可留空）
POSTGRES_PASSWORD=

# 前端来源，逗号分隔。**不能写 `*`** —— 通配符 + 带凭证的跨站请求
# 等于任意站点都能代表已登录用户发请求。
DJANGO_CORS_ORIGINS=https://tms.example.com

# 对外可访问的基址。头像、回单、证件的绝对地址靠它拼；
# 留成 127.0.0.1 的话用户点开图片会打到自己电脑上。
PUBLIC_BASE_URL=https://tms.example.com

# ── 常改 ──────────────────────────────────────────────────

POSTGRES_DB=tms
POSTGRES_USER=tms
# 托管 PG（TencentDB 等）时改这条，其余不用动
DATABASE_URL=postgres://tms:${POSTGRES_PASSWORD}@db:5432/tms

# 自助注册。默认 0（关）：账号该由管理员在「组织与权限 → 员工名录」
# 开通，开出来就带组织归属与角色。自助注册出来的账号无组织无角色，
# 业务上什么也干不了，却是一个任何人都能拿到的已认证身份。
# 只有对外客户门户需要自助开户时才置 1。
TMS_ALLOW_SELF_REGISTRATION=0

# ── 可选集成（不配则该功能关闭，不影响其余）──────────────

# AI 助手。不配则 /api/v1/ai/* 返回 503。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 地图与地理编码
AMAP_KEY=

# 车载终端 MQTT 接入。MQTT_HOST 为空即不启用——
# 绝大多数部署没有 broker，配一个不存在的地址只会让日志里滚重连错误。
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=tms/telemetry/#
MQTT_USERNAME=
MQTT_PASSWORD=

# 外部 MCP server（AI 工具扩展），逗号分隔的 URL
AGENT_MCP_SERVERS=

# 告警阈值
ALERT_SPEED_LIMIT_KMH=90
DEVICE_OFFLINE_MINUTES=10
