# 生产环境变量模板。
#
#   cp deploy/.env.prod.example deploy/.env.prod   # 然后逐项改
#
# .env.prod 本身**不要进版本库**（.gitignore 已经挡了）。
#
# 带 ⚠️ 的几项没有默认值：漏配的话 compose 会直接报错拒绝启动，
# 好过带着占位值跑起来——网关的启动前置检查也会在 DJANGO_DEBUG=false 时
# 拦住弱密钥与 CORS 通配符。

# ── ⚠️ 必改 ────────────────────────────────────────────────

# 强随机 ≥32 字节。生成：openssl rand -base64 48
# 这把钥匙同时签发内部用户令牌与司机端令牌。用公开已知的默认值
# 等于任何人都能自签一张管理员令牌进来。
DJANGO_SECRET_KEY=

# 数据库口令（用托管 PG 时改下面的 DATABASE_URL，这条可留空）
POSTGRES_PASSWORD=

# 前端来源，逗号分隔。**不能写 `*`** —— 通配符 + 带凭证的跨站请求
# 等于任意站点都能代表已登录用户发请求。
DJANGO_CORS_ORIGINS=https://tms.example.com

# 对外可访问的基址。头像、回单、证件的绝对地址靠它拼；
# 留成 127.0.0.1 的话用户点开图片会打到自己电脑上。
PUBLIC_BASE_URL=https://tms.example.com

# ── 常改 ──────────────────────────────────────────────────

POSTGRES_DB=tms
POSTGRES_USER=tms
# 托管 PG（TencentDB 等）时改这条，其余不用动
DATABASE_URL=postgres://tms:${POSTGRES_PASSWORD}@db:5432/tms

# 自助注册。默认 0（关）：账号该由管理员在「组织与权限 → 员工名录」
# 开通，开出来就带组织归属与角色。自助注册出来的账号无组织无角色，
# 业务上什么也干不了，却是一个任何人都能拿到的已认证身份。
# 只有对外客户门户需要自助开户时才置 1。
TMS_ALLOW_SELF_REGISTRATION=0

# ── 可选集成（不配则该功能关闭，不影响其余）──────────────

# AI 助手。不配则 /api/v1/ai/* 返回 503。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 地图与地理编码
AMAP_KEY=

# 车载终端 MQTT 接入。MQTT_HOST 为空即不启用——
# 绝大多数部署没有 broker，配一个不存在的地址只会让日志里滚重连错误。
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=tms/telemetry/#
MQTT_USERNAME=
MQTT_PASSWORD=

# 外部 MCP server（AI 工具扩展），逗号分隔的 URL
AGENT_MCP_SERVERS=

# 告警阈值
ALERT_SPEED_LIMIT_KMH=90
DEVICE_OFFLINE_MINUTES=10

# ── 连接池 ──────────────────────────────────────────────
# 不设时 pgx 默认 max(4, NumCPU)：4 条连接就是整个网关的吞吐天花板。
# 池大小 × 网关副本数 必须小于 PG 的 max_connections（默认 100）。
DB_MAX_CONNS=20
DB_MIN_CONNS=4

# ── 可观测 ──────────────────────────────────────────────
# 配了才开 /metrics（Prometheus 文本格式）；留空则该端点 404。
# 指标里有内网路由结构和流量画像，别裸奔。
#   生成：openssl rand -hex 24
METRICS_TOKEN=

# ── 自助找回密码的验证码下发通道 ────────────────────────
# 留空 = 不开自助找回。前端会明确提示"请联系管理员重置"，
# 而不是假装发出去了（验证码其实只进了服务器日志）。
# 开通填 smtp，并配齐下面四项。
TMS_RESET_CHANNEL=
TMS_SMTP_HOST=
TMS_SMTP_PORT=587
TMS_SMTP_USER=
TMS_SMTP_PASS=
TMS_SMTP_FROM=

# ── 媒体存放 ────────────────────────────────────────────
# local（默认）= 写容器本地盘。**只适用于单副本部署。**
#   多副本时上传落在 A 的盘上，下一次读被路由到 B 就 404——而且是间歇性的，
#   同一张图刷新几次可能好几次坏几次。预发通常单副本，这个问题在那儿看不见。
# s3 = 任何 S3 兼容对象存储（AWS S3 / 腾讯云 COS / 阿里云 OSS 的 S3 网关 / MinIO）
#
# 填了 s3 但少配任何一项，网关会**拒绝启动**而不是退回本地盘：
# 退回去会让多副本"看起来正常"地跑起来然后间歇丢文件，比起不来难查得多。
MEDIA_BACKEND=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO 与多数自建网关只支持 path-style（<endpoint>/<bucket>/<key>），置 1
S3_PATH_STYLE=0
